+        chars = [c for c in ln["chars"] if c["text"].strip()]
+        if chars:
+            out.append({"chars": chars, "s": "".join(c["text"] for c in chars), "top": ln["top"], "bottom": ln["bottom"],
+                        "x0": chars[0]["x0"], "x1": chars[-1]["x1"]})
+    return out
+
+
